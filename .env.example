# Live Supabase (chimera / lfyqdrjqfpczsfkqjxpq)
NEXT_PUBLIC_SUPABASE_URL=https://lfyqdrjqfpczsfkqjxpq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical public origin (no trailing slash). Used for post-auth redirects.
# Production should be the www host so PKCE cookies match Site URL.
# NEXT_PUBLIC_SITE_URL=https://www.joinbunk.xyz

# Explicit local demo (Austin seed in localStorage). When set, live backend is not used.
# NEXT_PUBLIC_BEAM_DEMO_MODE=1

# Never put service_role / secret keys in NEXT_PUBLIC_* or commit them.

# Server-only: urgent SMS matching + Twilio (optional; missing = skip SMS gracefully).
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Or use a Messaging Service instead of From:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# CRON_SECRET=  # Bearer token for /api/cron/urgent-escalate
# Twilio inbound webhook URL (STOP/START/HELP legacy): https://www.yariapp.com/api/twilio/inbound
# Phone-confirm inbound webhook (onboarding QR / Text us): https://www.joinbunk.xyz/api/sms/inbound
# Point the Twilio number's messaging webhook to the joinbunk.xyz SMS inbound URL in production.

# Server-only: Resend for transactional email (optional; missing = skip email gracefully).
# Used for account-deletion confirmation and /help contact inbox. Never blocks deletion when unset.
# RESEND_API_KEY=
# EMAIL_FROM=Bunk <no-reply@joinbunk.xyz>
# SUPPORT_INBOX_EMAIL=support@joinbunk.xyz
