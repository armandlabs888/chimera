NEXT_PUBLIC_SUPABASE_URL=https://lfyqdrjqfpczsfkqjxpq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical public origin (no trailing slash). Used for post-auth redirects.
# Production should be the www host so PKCE cookies match Site URL.
# NEXT_PUBLIC_SITE_URL=https://www.yariapp.com

# Explicit local demo (Austin seed in localStorage). When set, live backend is not used.
# NEXT_PUBLIC_BEAM_DEMO_MODE=1

# Never put service_role / secret keys in NEXT_PUBLIC_* or commit them.

# Server-only: urgent SMS matching + Twilio (optional; missing = skip SMS gracefully).
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Or use a Messaging Service instead of From:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxx
# CRON_SECRET=  # Bearer token for /api/cron/urgent-escalate
# Twilio inbound webhook URL: https://www.yariapp.com/api/twilio/inbound
